# API base URL
# Development:
# VITE_API_URL=http://localhost:3001/api

# Production (replace with your actual domain):
VITE_API_URL=https://your-domain.com/api

# Asset/uploads base URL (for serving uploaded files, images, circular attachments)
# Development:
# VITE_ASSETS_URL=http://localhost:3001
# Production:
VITE_ASSETS_URL=https://your-domain.com
