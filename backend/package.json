{
  "name": "school-crm-backend",
  "version": "1.0.0",
  "description": "School Management CRM System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "migrate": "node database/migrations/migrate.js",
    "create-users": "node database/seeds/createUsers.js",
    "setup": "npm run migrate && node database/seeds/createClasses.js && node database/seeds/resetSubjects.js && node database/seeds/resetExamTypes.js && npm run create-users"
  },
  "keywords": [
    "school",
    "crm",
    "management",
    "education"
  ],
  "author": "School CRM Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.14.0",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "pm2": "^6.0.14",
    "sequelize": "^6.37.7",
    "twilio": "^4.23.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
