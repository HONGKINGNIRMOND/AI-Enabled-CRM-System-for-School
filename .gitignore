# School CRM - Root .gitignore

# Dependencies
node_modules/

# Environment files - NEVER commit these
.env
.env.local
.env.production
.env.staging

# Build output
dist/
build/

# PM2 logs
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploaded files (user content, too large for git)
backend/uploads/*
!backend/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Coverage
coverage/
.nyc_output

# Misc
*.tgz
.cache
